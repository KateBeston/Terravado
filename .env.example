# Terravado environment — copy to .env.local and fill in once you create a
# Supabase project (Sydney region, ap-southeast-2).
#
# Project Settings -> API in the Supabase dashboard:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only key for admin tasks / seeding reference data. NEVER expose this
# to the browser. Leave unset until you need server-side admin writes.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
